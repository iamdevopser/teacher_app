# Teacher Planner — Supabase (sync) configuration
#
# Flutter does NOT load this file automatically. Pass values at build/run time:
#   flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
#
# For local shell scripts (e.g. run/run_apk.ps1), set environment variables:
#   PowerShell:  $env:SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
#                $env:SUPABASE_ANON_KEY="your_anon_key"
#   Bash:        export SUPABASE_URL=...  export SUPABASE_ANON_KEY=...
#
# Copy this file to .env only if you use tooling that reads it (optional).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
